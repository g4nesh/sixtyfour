# Server-side only. Copy to .env for local live mode (gitignored).
# Never expose these through NEXT_PUBLIC_* variables.
ATLAS_LIVE_ENABLED=true

# OpenAI (preferred). A small, low-cost model drives the local tool-calling
# harness; web discovery uses the OpenAI Responses web_search tool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (optional fallback if no OPENAI_API_KEY is set).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4
