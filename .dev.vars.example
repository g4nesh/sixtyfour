# Server-side only. Copy to .dev.vars for local Worker development (gitignored).
# Never expose these through NEXT_PUBLIC_* variables.
ATLAS_LIVE_ENABLED=false

# Required for non-local live HTTP ingress. Generate at least 32 random bytes,
# store the value in the deployment secret manager, and send it only as an
# Authorization: Bearer header. `npm run dev` enables a loopback-only bypass;
# never set ATLAS_ALLOW_UNAUTHENTICATED_LOCAL on public ingress.
# ATLAS_API_TOKEN=

# Provider selection: openai | gemini | anthropic (or claude) | openrouter.
# Auto-detects if unset (gemini, then openai, anthropic, and openrouter).
# LIVE_PROVIDER=openai

# Optional cross-provider discovery. This is never enabled merely because an
# OpenAI key is present: set it explicitly to use OpenAI Responses web_search
# while Gemini, Anthropic, or OpenRouter handles planning/extraction turns.
# LIVE_SEARCH_PROVIDER=openai

# OpenAI. A small, low-cost model drives the local tool-calling harness; web
# discovery uses the OpenAI Responses web_search tool.
# NOTE: free-tier keys allow only ~50 requests/day (RPD); one investigation
# uses ~15-20, so add a small amount of billing for repeated runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini uses the OpenAI-compatible endpoint for structured reasoning
# turns and the native Interactions API with Google Search for grounded web
# discovery. Google Search grounding can be billable; configure account limits
# before enabling live mode on shared ingress.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude uses the native Messages API for structured tool calls and
# the versioned web_search_20250305 server tool for bounded discovery.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (optional fallback).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4
# OPENROUTER_SITE_URL=https://your-deployment.example
# OPENROUTER_APP_NAME=Atlas
