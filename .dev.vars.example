# Server-side only. Copy to .env for local live mode (gitignored).
# Never expose these through NEXT_PUBLIC_* variables.
ATLAS_LIVE_ENABLED=true

# Provider selection: gemini | openai | openrouter. Auto-detects if unset
# (gemini, then openai, then openrouter).
# LIVE_PROVIDER=openai

# OpenAI. A small, low-cost model drives the local tool-calling harness; web
# discovery uses the OpenAI Responses web_search tool.
# NOTE: free-tier keys allow only ~50 requests/day (RPD); one investigation
# uses ~15-20, so add a small amount of billing for repeated runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini uses the OpenAI-compatible endpoint for structured reasoning
# turns and the native Interactions API with Google Search for grounded web
# discovery. Google Search grounding can be billable; configure account limits
# before enabling live mode on shared ingress.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (optional fallback).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4
