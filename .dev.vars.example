# Server-side only. Copy to .dev.vars for local Worker development (gitignored).
# Never expose these through NEXT_PUBLIC_* variables.
ATLAS_LIVE_ENABLED=false

# Required for non-local live HTTP ingress. Generate at least 32 random bytes
# and store the value only in the deployment secret manager. The dashboard
# exchanges it once for a short-lived HttpOnly session cookie. `npm run dev`
# enables a loopback-only bypass; never enable that bypass on public ingress.
# ATLAS_API_TOKEN=

# OpenRouter is the only accepted external live provider. It handles reasoning,
# tool calls, and bounded server-side web search. A nonempty LIVE_PROVIDER value
# must be exactly `openrouter`; stale direct-provider pins fail closed.
LIVE_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-nano
# OPENROUTER_SITE_URL=https://your-deployment.example
# OPENROUTER_APP_NAME=Atlas
