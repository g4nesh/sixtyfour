{
  "name": "atlas-people-intelligence",
  "version": "0.1.0",
  "description": "Auditable public-source professional identity research with deterministic replays.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g4nesh/sixtyfour.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "ATLAS_ALLOW_UNAUTHENTICATED_LOCAL=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=/tmp/atlas-wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:pdf": "ATLAS_PDF_SMOKE=1 node --experimental-strip-types --test tests/report-export.test.mjs",
    "test:browser": "node --test tests/browser/playwright.test.mjs",
    "test:browser:live": "ATLAS_LIVE_E2E=1 node --test --test-name-pattern='credentialed live' tests/browser/playwright.test.mjs",
    "test:selenium": "node tests/browser/selenium-smoke.mjs",
    "test:selenium:safari": "ATLAS_SELENIUM_BROWSER=safari node tests/browser/selenium-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "local:openrouter": "node scripts/run-local-openrouter.mjs",
    "local:openrouter:check": "node scripts/run-local-openrouter.mjs --check",
    "macos:service": "node scripts/macos-service.mjs",
    "container:configure": "node scripts/configure-openrouter-container.mjs",
    "container:up": "docker compose --env-file .env.atlas up --build --force-recreate -d",
    "container:down": "docker compose --env-file .env.atlas down",
    "container:logs": "docker compose --env-file .env.atlas logs --follow atlas",
    "examples:generate": "node scripts/run-generator.mjs",
    "report:example": "node scripts/render-example-report.mjs chris-anderson-ted",
    "verify": "npm run format:check && npm run security:secrets && npm run typecheck && npm run lint && npm test",
    "atlas": "node bin/run.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@react-pdf/renderer": "4.6.1",
    "@xyflow/react": "12.11.3",
    "elkjs": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.3.0",
    "selenium-webdriver": "4.49.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "ws": "8.21.3"
  },
  "type": "module"
}
